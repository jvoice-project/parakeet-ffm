+// Append a floating-point number to `out` formatted with `fmt` (e.g. "%.3f")
+// using decimal point regardless of the active locale. NaN/Inf are emitted as 0
+// (JSON has no NaN/Inf literal); confidences/times are finite here.
+template <typename T>
+static void append_json_fp(std::string& out, const char* fmt, T v) {
+    if (!std::isfinite(v) || v > 1e30 || v < -1e30) {  // NaN or huge -> 0
         out += '0';
         return;
     }
-    std::snprintf(buf, sizeof(buf), fmt, v);
-    out += buf;
+    char buf[64];
+    int n = std::snprintf(buf, sizeof(buf), fmt, (double)v);
+    if (n > 0) {
+        for (int i = 0; i < n && i < (int)sizeof(buf); ++i) {
+            if (buf[i] == ',') buf[i] = '.';
+        }
+        out.append(buf, n);
+    } else {
+        out += '0';
+    }
+}
+
+void append_json_float(std::string& out, const char* fmt, float v) {
+    append_json_fp(out, fmt, v);
+}
+
+void append_json_float(std::string& out, const char* fmt, double v) {
+    append_json_fp(out, fmt, v);
 }
 
