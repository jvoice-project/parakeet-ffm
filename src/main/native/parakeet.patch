-// Append a float to `out` formatted with `fmt` (e.g. "%.3f"). NaN/Inf are
-// emitted as 0 (JSON has no NaN/Inf literal); confidences/times are finite here.
-void append_json_float(std::string& out, const char* fmt, float v) {
-    char buf[32];
-    if (!(v == v) || v > 1e30f || v < -1e30f) {  // NaN or huge -> 0
+// Append a floating-point number to `out` formatted with `fmt` (e.g. "%.3f")
+// using decimal point regardless of the active locale. NaN/Inf are emitted as 0
+// (JSON has no NaN/Inf literal); confidences/times are finite here.
+template <typename T>
+static void append_json_fp(std::string& out, const char* fmt, T v) {
+    if (!std::isfinite(v) || v > 1e30 || v < -1e30) {  // NaN or huge -> 0
         out += '0';
         return;
     }
-    std::snprintf(buf, sizeof(buf), fmt, v);
-    out += buf;
+    int prec = 3;
+    if (fmt && fmt[0] == '%' && fmt[1] == '.') {
+        char* end = nullptr;
+        long p = std::strtol(fmt + 2, &end, 10);
+        if (end && *end == 'f') prec = (int)p;
+    }
+#if defined(__cpp_lib_to_chars)
+    char buf[64];
+    auto res = std::to_chars(buf, buf + sizeof(buf), v, std::chars_format::fixed, prec);
+    if (res.ec == std::errc()) {
+        out.append(buf, res.ptr - buf);
+        return;
+    }
+#endif
+    std::ostringstream oss;
+    oss.imbue(std::locale::classic());
+    oss << std::fixed << std::setprecision(prec) << v;
+    out += oss.str();
+}
+
+void append_json_float(std::string& out, const char* fmt, float v) {
+    append_json_fp(out, fmt, v);
+}
+
+void append_json_float(std::string& out, const char* fmt, double v) {
+    append_json_fp(out, fmt, v);
 }
 
